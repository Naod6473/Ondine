{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "L'île et les réglages : commandes applicatives déclarées explicitement, aucun contenu distant.",
  "windows": [
    "island",
    "settings"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-boot",
    "allow-settings-patch",
    "allow-settings-export",
    "allow-settings-import",
    "allow-settings-import-pick",
    "allow-apps-detect",
    "allow-privacy-check-folder",
    "allow-dialog-pick-folder",
    "allow-dialog-pick-file",
    "allow-island-set-collapsed",
    "allow-island-set-tall",
    "allow-island-set-rect",
    "allow-island-set-focus",
    "allow-island-reposition",
    "allow-island-drag-start",
    "allow-pet-open",
    "allow-pet-bubble",
    "allow-pet-drag-start",
    "allow-pet-set-hit",
    "allow-pet-place",
    "allow-pet-back",
    "allow-desk-state",
    "allow-ui-language",
    "allow-log-write",
    "allow-logs-open-folder",
    "allow-credential-exists",
    "allow-credential-set",
    "allow-credential-delete",
    "allow-bus-publish",
    "allow-module-invoke",
    "allow-undo-run",
    "allow-settings-open-window",
    "allow-window-hide",
    "allow-app-quit",
    "allow-update-check",
    "allow-update-install",
    "allow-release-page-open",
    "allow-profile-activate",
    "allow-profile-wifi-name",
    "allow-bug-report-open",
    "allow-self-usage",
    "allow-perf-state",
    "allow-phone-certificate-setup",
    "allow-phone-list",
    "allow-phone-revoke",
    "allow-phone-activate"
  ]
}

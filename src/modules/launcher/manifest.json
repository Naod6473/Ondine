{
  "id": "launcher",
  "name": "Lanceur",
  "icon": "🚀",
  "description": "Un raccourci clavier (Alt+Espace par défaut) ouvre une recherche : applications du menu Démarrer, outils Windows (Services, Gestionnaire de périphériques…), fichiers récents, serveurs favoris (Accès distants) et actions de l'île. Il cherche aussi dans l'île : notes et tâches, presse-papiers, étagère et captures. Entrée pour ouvrir.",
  "version": "0.1.0",
  "permissions": [
    "files"
  ],
  "settings": {
    "version": 1,
    "fields": [
      {
        "key": "hotkey",
        "type": "select",
        "label": "Raccourci",
        "default": "Alt+Space",
        "options": [
          {
            "value": "Alt+Space",
            "label": "Alt + Espace"
          },
          {
            "value": "Ctrl+Space",
            "label": "Ctrl + Espace"
          },
          {
            "value": "Ctrl+Alt+Space",
            "label": "Ctrl + Alt + Espace"
          },
          {
            "value": "Ctrl+Shift+Space",
            "label": "Ctrl + Maj + Espace"
          },
          {
            "value": "Super+Shift+Space",
            "label": "Win + Maj + Espace"
          },
          {
            "value": "off",
            "label": "Aucun (seulement l'onglet)"
          }
        ]
      },
      {
        "key": "showRecent",
        "type": "boolean",
        "label": "Proposer les fichiers ouverts récemment",
        "help": "Ceux des dossiers exclus (Confidentialité) ne sont jamais montrés.",
        "default": true
      },
      {
        "key": "searchIsland",
        "type": "boolean",
        "label": "Chercher aussi dans l'île (notes, presse-papiers, étagère, captures)",
        "help": "5 résultats au plus par source, groupés. Les dossiers exclus (Confidentialité) ne sont jamais montrés.",
        "default": true
      }
    ]
  },
  "views": [
    "expanded"
  ],
  "commands": [
    "entries",
    "launch",
    "forget_focus",
    "search",
    "open_found"
  ],
  "events": {
    "emits": [
      "launcher.open",
      "launcher.hotkey-error",
      "terminal.open",
      "timer.start",
      "remote.connect",
      "agents.launch",
      "notes.open",
      "capture.pick",
      "easter.word"
    ],
    "listens": [
      "launcher.open",
      "launcher.hotkey-error",
      "remote.changed",
      "agents.projects"
    ]
  }
}
